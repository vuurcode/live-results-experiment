# Standard library only: nothing to download or verify beyond the pinned base image.
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build

WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOTOOLCHAIN=local

COPY go.mod ./
COPY main.go generate.go startlist.go ./
RUN go build -trimpath -ldflags="-s -w" -o /mockserver .

FROM scratch
WORKDIR /app
COPY --from=build /mockserver /mockserver
# Without samples mounted at /app/data (one directory per competition) it serves three generated matches
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/mockserver"]
