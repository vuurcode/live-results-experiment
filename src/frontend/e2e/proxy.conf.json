{
  "^/dts(/|$)": {
    "target": "http://127.0.0.1:14201",
    "ws": true,
    "changeOrigin": true
  },
  "^/dts-admin(/|$)": {
    "target": "http://127.0.0.1:14202",
    "ws": true,
    "changeOrigin": true
  },
  "/ws": {
    "target": "ws://localhost:15000",
    "ws": true,
    "changeOrigin": true
  },
  "/api": {
    "target": "http://localhost:15000",
    "changeOrigin": true
  },
  "/dts-api/admin": {
    "target": "http://localhost:15002",
    "changeOrigin": true,
    "headers": { "Authorization": "Bearer dev-admin-secret" }
  },
  "/dts-api": {
    "target": "http://localhost:15002",
    "changeOrigin": true
  }
}
