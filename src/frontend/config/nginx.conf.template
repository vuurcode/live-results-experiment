# Template: FRONTEND_LISTEN_PORT, FRONTEND_BACKEND_UPSTREAM (host:port of the backend) and FRONTEND_CLIENT_IP_VAR (the nginx variable
# holding the client address header, $remote_addr without one) are filled in when the container starts.
server_tokens off;

# Basic auth has no lockout of its own: the locations behind a password allow a client address a steady 30 requests a minute
# (the pages poll the API, so a short burst is fine). The service counts wrong keys itself; this covers the passwords.
# The client address is the last entry of the header the hosting sets (BACKEND_CLIENT_IP_HEADER), else the connection's address.
map ${FRONTEND_CLIENT_IP_VAR} $dts_client {
    default $remote_addr;
    ~(?<last>[^,\s]+)\s*$ $last;
}
limit_req_zone $dts_client zone=dts_auth:2m rate=30r/m;
limit_req_status 429;

# text assets compress to about a quarter; the websocket and already compressed images are left alone
gzip on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_vary on;
gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain image/x-icon;

server {
    listen ${FRONTEND_LISTEN_PORT};
    root /usr/share/nginx/html;
    # The container listens on a port the hosting does not expose and sees plain http: redirects stay relative to the address the client used.
    absolute_redirect off;

    # Every location includes the security headers itself: a location with an add_header of its own drops the inherited ones.
    # The management application's files sit behind its login like its pages. They are matched here, before the
    # general file rules below, because a regular expression location outranks the /dts-admin/ prefix location, which therefore is not marked ^~.
    location ~ "^/dts-admin/.+-[A-Z0-9]{8}\.(js|css)$" {
        include /etc/nginx/dts-admin-auth.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    location ~* "^/dts-admin/.+\.[a-z0-9]+$" {
        include /etc/nginx/dts-admin-auth.conf;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    # Files with a hash in their name never change: cache them for good.
    location ~ "^/.+-[A-Z0-9]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    # The page and the runtime settings change with a deploy: always revalidate.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    # /dts is the signers' application; it is served from the trailing-slash form
    location = /dts {
        return 302 /dts/;
    }
    # /dts-admin is the management application. Everything under it asks for the one DTS login; without
    # DTS_ADMIN_PASSWORD the include denies everyone. It shares no page with the signers' application.
    location = /dts-admin {
        return 302 /dts-admin/;
    }
    # The addresses the management pages had before they moved
    location ~ "^/dts/(list|manage)/?$" {
        return 302 /dts-admin/list$is_args$args;
    }
    location /dts-admin/ {
        include /etc/nginx/dts-admin-auth.conf;
        limit_req zone=dts_auth burst=60 nodelay;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri /dts-admin/index.html;
    }
    location = /dts/index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    location = /dts-admin-sw.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    location = /dts-sw.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    location = /env-inject.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    # Anything with a file extension that does not exist is a real 404; only page routes fall back to the app.
    location ~* \.[a-z0-9]+$ {
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    # The sign pages and /dts-api are not behind the login: the sessions are protected by their keys.
    location /dts/ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri /dts/index.html;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
    location ^~ /api {
        include /etc/nginx/security-headers.conf;
        # The headers the include sets are not repeated by the backend's own copies
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_pass http://${FRONTEND_BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # The experimental DTS sign-in service. It is reached only through here; nginx appends the client address to
    # X-Forwarded-For, which the service reads (DTS_CLIENT_IP_HEADER) for its rate limit. An upload is a few MB of XML.
    # The admin endpoints sit behind the same login; nginx adds the secret the service requires, so the browser never holds it.
    location ^~ /dts-api/admin/ {
        include /etc/nginx/dts-admin-auth.conf;
        limit_req zone=dts_auth burst=60 nodelay;
        include /etc/nginx/dts-admin-secret.conf;
        client_max_body_size 6m;
        include /etc/nginx/security-headers.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Robots-Tag;
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /dts-api/ {
        include /etc/nginx/security-headers.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Robots-Tag;
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Liveness of the backend behind the proxy (the page routes above fall back to the app, so this needs its own entry).
    location = /healthcheck {
        proxy_pass http://${FRONTEND_BACKEND_UPSTREAM};
        access_log off;
    }
    location ^~ /ws {
        proxy_pass http://${FRONTEND_BACKEND_UPSTREAM}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        # the backend pings every 25 seconds; an idle socket is not dropped before that matters
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
