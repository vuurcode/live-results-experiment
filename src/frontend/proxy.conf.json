{
  "^/dts(/|$)": {
    "target": "http://localhost:4201",
    "ws": true,
    "changeOrigin": true
  },
  "^/dts-admin(/|$)": {
    "target": "http://127.0.0.1:4202",
    "ws": true,
    "changeOrigin": true
  },
  "/ws": {
    "target": "ws://backend:5000",
    "ws": true,
    "changeOrigin": true
  },
  "/api": {
    "target": "http://backend:5000",
    "changeOrigin": true
  },
  "/dts-api/admin": {
    "target": "http://backend:5002",
    "changeOrigin": true,
    "headers": { "Authorization": "Bearer dev-admin-secret" }
  },
  "/dts-api": {
    "target": "http://backend:5002",
    "changeOrigin": true
  }
}
